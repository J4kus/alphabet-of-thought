.vscode/**
.vscode-test/**
.gitignore
# the token experiment's tokenizer is installed on demand (--no-save) and is
# large; it must never ride along in the vsix even when it is present
node_modules/gpt-tokenizer/**
vsc-extension-quickstart.md
*.vsix
# bytecode anywhere: a stale .pyc beside the runtime must never ship
**/__pycache__/**
out/**
lp.py
install.py
parser.out
*.aot
# the Python runtime the editor starts for `=` derivations ships with it
!src/aot_runtime.py
