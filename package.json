{
  "name": "alphabet-of-thought",
  "displayName": "alphabet of thought",
  "description": "distill your creativity into code",
  "keywords": [
    "aot",
    "alphabet of thought",
    "programming language",
    "syntax highlighting",
    "code editor",
    "ideas"
  ],
  "license": "MIT",
  "version": "1.7.1",
  "publisher": "Jakus",
  "icon": "alpha.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node out/test-linter.js && node out/test-table.js && node out/test-extension.js && node out/test-armstrong.js && node out/test-fca.js && node out/test-godel.js && node out/test-derive.js && node out/test-urls.js && node out/test-hold.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "aot",
        "aliases": [
          "alphabet of thought",
          "aot"
        ],
        "extensions": [
          ".aot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aot",
        "scopeName": "source.aot",
        "path": "./syntaxes/aot.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "alphabet of thought",
      "properties": {
        "aot.tableCsvSync": {
          "type": "boolean",
          "default": true,
          "description": "Mirror every table to a CSV named after its parent Concept in a single 'aot.files' folder at the workspace root (shared by every .aot in the repo), and fold edits made to those CSVs back into the matching table. A CSV whose Concept no table anywhere still has is archived with a '_' prefix, never deleted; legacy 'tables.<file>' / '<file>.tables' folders are folded in automatically."
        },
        "aot.spellingHints": {
          "type": "boolean",
          "default": true,
          "description": "Hint words longer than four characters that neither British nor American English knows, with suggestions. Hints show on their span and on hover, never in the Problems panel."
        },
        "aot.exampleHints": {
          "type": "boolean",
          "default": true,
          "description": "Hint a value that names no Example of the Concept typing its attribute \u2014 'person: James' where Person's Examples are Socrates alone. Only Concepts that list Examples are held to, and only values of the same kind as those Examples (a truth value or a measurement never counts). Hints show on their span and on hover, never in the Problems panel; the Quick Fix lists the Example."
        },
        "aot.acceptedWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Your own vocabulary, case-insensitive: the spelling hints accept these words, and a Concept whose last word is one of them is not flagged as plural. The Quick Fix on either finding adds the word here."
        },
        "aot.dependencyFindings": {
          "type": "boolean",
          "default": false,
          "description": "Surface inferred functional-dependency warnings (derivable / equivalent attributes) as editor squiggles. Off by default \u2014 correlated attributes are allowed; 'node verify.js --fd' always shows the full set."
        },
        "aot.chainHints": {
          "type": "boolean",
          "default": true,
          "description": "Show an abbreviated dependency chain in faint inline text (an inlay hint) at the end of lines whose crosslink declares a dependency \u2014 the full chains stay on hover."
        },
        "aot.urlMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Hovering a URL in a value fetches light metadata (status, content type, last modified) with a HEAD request, cached for a few minutes. Ctrl+click always opens the URL, metadata or not."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "aotAttribute",
        "description": "A table cell's attribute"
      },
      {
        "id": "aotExample",
        "description": "A table cell's Example name"
      },
      {
        "id": "aotValue",
        "description": "A table cell's Attribute Value"
      },
      {
        "id": "aotFormula",
        "description": "A formula or constraint"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "aot",
        "scopes": {
          "aotAttribute": [
            "variable.other.property.aot"
          ],
          "aotExample": [
            "constant.language.individual.aot"
          ],
          "aotValue": [
            "string.unquoted.value.aot"
          ],
          "aotFormula": [
            "keyword.control.formula.aot"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "aot.table.nextCell",
        "title": "Next Cell",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.prevCell",
        "title": "Previous Cell",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.nextRow",
        "title": "Next Row",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.moveColumnLeft",
        "title": "Move Column Left",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.moveColumnRight",
        "title": "Move Column Right",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.moveRowUp",
        "title": "Move Row Up",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.moveRowDown",
        "title": "Move Row Down",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.insertColumn",
        "title": "Insert Column",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.deleteColumn",
        "title": "Delete Column",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.insertRow",
        "title": "Insert Row Above",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.deleteRow",
        "title": "Delete Row",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.insertSeparator",
        "title": "Insert Separator Below",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.sortRows",
        "title": "Sort Rows by Column at Cursor",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.fromSelection",
        "title": "Create Table from Selected Lines",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.copyFormulaDown",
        "title": "Copy Formula Down the Column",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.table.copyFormulaAcross",
        "title": "Copy Formula Across the Row",
        "category": "AOT Table",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.recomputeFormulas",
        "title": "Recompute Formulas",
        "category": "AOT",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.copyFormulaToSiblings",
        "title": "Copy Formula to Sibling Examples",
        "category": "AOT",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.addExample",
        "title": "Add Example to Concept",
        "category": "AOT",
        "enablement": "editorLangId == aot"
      },
      {
        "command": "aot.copyFileIntoRepo",
        "title": "Copy File at Cursor into aot.files",
        "category": "AOT",
        "enablement": "editorLangId == aot"
      }
    ],
    "keybindings": [
      {
        "command": "aot.table.nextCell",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "command": "aot.table.prevCell",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "command": "aot.table.nextRow",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable && !suggestWidgetVisible"
      },
      {
        "command": "aot.table.moveColumnLeft",
        "key": "alt+left",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.moveColumnRight",
        "key": "alt+right",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.moveRowUp",
        "key": "alt+up",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.moveRowDown",
        "key": "alt+down",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.insertColumn",
        "key": "alt+shift+right",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.deleteColumn",
        "key": "alt+shift+left",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.insertRow",
        "key": "alt+shift+down",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.deleteRow",
        "key": "alt+shift+up",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      },
      {
        "command": "aot.table.insertSeparator",
        "key": "alt+-",
        "when": "editorTextFocus && !editorReadonly && editorLangId == aot && aot.inTable"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jakus23/alphabet-of-thought.git"
  },
  "dependencies": {
    "dictionary-en": "^3.2.0",
    "dictionary-en-gb": "^2.4.0",
    "nspell": "^2.1.5",
    "pluralize": "^8.0.0"
  }
}
