{
  "name": "alphabet-of-thought",
  "displayName": "alphabet of thought",
  "description": "distill your creativity into code",
  "keywords": [
    "aot",
    "alphabet of thought",
    "programming language",
    "syntax highlighting",
    "code editor",
    "ideas"
  ],
  "license": "MIT",
  "version": "1.13.1",
  "publisher": "Jakus",
  "icon": "alpha.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Python derivations never run in an untrusted workspace: they are code the files carry. Everything else works.",
      "restrictedConfigurations": [
        "aot.python.enabled",
        "aot.python.manager",
        "aot.python.path",
        "aot.uv.path",
        "aot.python.allowSubprocess",
        "aot.python.allowNetwork",
        "aot.python.protectCredentials",
        "aot.python.maxMemoryMb"
      ]
    }
  },
  "scripts": {
    "test": "node out/test-linter.js && node out/test-table.js && node out/test-extension.js && node out/test-armstrong.js && node out/test-fca.js && node out/test-godel.js && node out/test-derive.js && node out/test-repo.js && node out/test-urls.js && node out/test-hold.js && node out/test-synonyms.js && node out/test-park.js && node out/test-lineform.js && node out/test-python.js && node out/test-uv.js && node out/test-merge.js && node out/test-csvsync.js"
  },
  "contributes": {
    "configurationDefaults": {
      "[aot]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "languages": [
      {
        "id": "aot",
        "aliases": [
          "alphabet of thought",
          "aot"
        ],
        "extensions": [
          ".aot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aot",
        "scopeName": "source.aot",
        "path": "./syntaxes/aot.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "alphabet of thought",
      "properties": {
        "aot.tableCsvSync": {
          "type": "boolean",
          "default": true,
          "description": "Mirror every Concept with Examples to a CSV named after it in a single 'aot.files' folder at the repository root (shared by every .aot in the repo), and keep the two in step both ways: each cell is merged against what the two last agreed on, so whichever side changed it is the one that counts, an emptied cell empties, a dropped row is asked about, and a cell both sides changed goes to the later save (and is said). A CSV whose Concept no file speaks for any more is archived with a '_' prefix, never deleted."
        },
        "aot.tableCsvSyncMode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "enumDescriptions": [
            "Sync on every .aot save, every CSV edit, and when the editor starts.",
            "Sync only on AOT: Sync CSVs Now (Ctrl+K Y)."
          ],
          "default": "auto",
          "description": "When the CSV mirror syncs. Either way the sync is the same three-way merge; manual only chooses the moment."
        },
        "aot.spellingHints": {
          "type": "boolean",
          "default": true,
          "description": "Hint words longer than four characters that neither British nor American English knows, with suggestions. Hints show on their span and on hover, never in the Problems panel."
        },
        "aot.exampleHints": {
          "type": "boolean",
          "default": true,
          "description": "Hint a value that names no Example of the Concept typing its attribute \u2014 'person: James' where Person's Examples are Socrates alone. Only Concepts that list Examples are held to, and only values of the same kind as those Examples (a truth value or a measurement never counts). Hints show on their span and on hover, never in the Problems panel; the Quick Fix lists the Example."
        },
        "aot.autoReconcile": {
          "type": "boolean",
          "default": true,
          "description": "Keep a Concept that appears in more than one .aot in step, on save. An attribute a peer declares and this file does not have in force is written in, and the '...' line saying how many Examples live elsewhere is kept true. Additive only: nothing you wrote is deleted, and no other file is touched. The disagreements no tool may settle \u2014 one attribute carrying two values, one Concept filed under two kinds \u2014 stay put as errors. Off, the drift is reported as a warning instead."
        },
        "aot.synonymWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Warn when two Concepts look like two names for one idea \u2014 'Client' beside 'Customer' (two words for one idea), 'Governance' beside 'Government' (one word with two endings). Repo-wide: a peer in another .aot counts, and the warning carries a link to it. Advisory, never counted in V; the lightbulb either renames one to the other or records the pair in aot.distinctConcepts and stops asking."
        },
        "aot.godelRegistry": {
          "type": "boolean",
          "default": true,
          "description": "Keep the G\u00f6del numbers stable in aot.files/godel.tsv: a prime per attribute and a code per value, written on save when the repository gains one, so the numbers the hover and verify.js --godel show stay put when an unrelated attribute is added, and mean the same in every file and branch. Commit it; AOT: Set Up Git Merge for .aot Files merges it with git's union driver. Safe to delete: it is rebuilt, with new numbers."
        },
        "aot.distinctConcepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Pairs of Concept names you have declared genuinely different, written 'client|customer'. The synonym warning skips them, in either order and in any file. The Quick Fix on the warning adds the pair here."
        },
        "aot.acceptedWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Your own vocabulary, case-insensitive: the spelling hints accept these words, and a Concept whose last word is one of them is not flagged as plural. The Quick Fix on either finding adds the word here."
        },
        "aot.dependencyFindings": {
          "type": "boolean",
          "default": false,
          "description": "Surface inferred functional-dependency warnings (derivable / equivalent attributes) as editor squiggles. Off by default \u2014 correlated attributes are allowed; 'node verify.js --fd' always shows the full set."
        },
        "aot.chainHints": {
          "type": "boolean",
          "default": true,
          "description": "Show an abbreviated dependency chain in faint inline text (an inlay hint) at the end of lines whose crosslink declares a dependency \u2014 the full chains stay on hover."
        },
        "aot.urlMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Hovering a URL in a value fetches light metadata (status, content type, last modified) with a HEAD request, cached for a few minutes. Ctrl+click always opens the URL, metadata or not."
        },
        "aot.parkedValueMarks": {
          "type": "boolean",
          "default": true,
          "description": "Tint every value whose derivation is parked in 'aot.files/<file>.formulas', so a computed number is never mistaken for a typed one, and every attribute whose constraint is parked there, so a hidden rule is never mistaken for none. Hover names the formula or the constraint and offers to put them back. The mark is a background only \u2014 no text is added, so a marked cell keeps the width its column aligned it to."
        },
        "aot.python.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Run the Python a file carries: its '=' derivations and its constraints' bounds. Off by default: a derivation is code, and it runs with your permissions. Runs happen only when asked (Ctrl+Enter, F9, or the park key), only in a trusted workspace, and each .aot's Python and each Python file are asked about before they first run and again when they change outside this editor. A user setting only: no repository can turn it on for you."
        },
        "aot.python.manager": {
          "type": "string",
          "enum": [
            "auto",
            "uv",
            "python"
          ],
          "enumDescriptions": [
            "aot.python.path when it is set, else the uv environment 'AOT: Set Up Python Environment' made here, else 'python' on PATH.",
            "The uv environment only; a run with none says to set one up.",
            "aot.python.path, else 'python' on PATH; never a uv environment."
          ],
          "default": "auto",
          "scope": "machine",
          "description": "Which Python the derivations run in. A user setting only."
        },
        "aot.python.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The Python interpreter to run derivations with, as an absolute path. Empty uses the uv environment (see aot.python.manager), else 'python' found on PATH \u2014 never one in the folder the run starts in. A user setting only: no repository can choose the program that runs."
        },
        "aot.uv.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "uv, the Python package manager 'AOT: Set Up Python Environment' uses, as an absolute path. Empty finds 'uv' on PATH. A user setting only."
        },
        "aot.python.maxMemoryMb": {
          "type": "number",
          "default": 4096,
          "minimum": 0,
          "scope": "machine",
          "description": "The most memory a derivations' Python may take, in megabytes; past it an allocation fails instead of the machine grinding. Enforced by the operating system (a job object on Windows, an address-space limit elsewhere). 0 sets no limit. A user setting only."
        },
        "aot.python.allowSubprocess": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Let the derivations' Python start other programs (os.system, subprocess). Off: on Windows the operating system refuses any child process; elsewhere Python refuses the calls that start one \u2014 a guard that code determined to escape can get past. A user setting only."
        },
        "aot.python.allowNetwork": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Let the derivations' Python open network connections \u2014 an API, a URL pd.read_csv reads. Off, Python refuses to connect: a guard, not a firewall, that code determined to escape can get past. A user setting only."
        },
        "aot.python.protectCredentials": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Refuse the derivations' Python any file in the places credentials are kept \u2014 ~/.ssh, ~/.aws, ~/.azure, ~/.config/gcloud, ~/.kube, ~/.docker, ~/.gnupg, ~/.netrc, ~/.git-credentials, the browsers' profiles, the Windows credential store. A guard that code determined to escape can get past. A user setting only."
        },
        "aot.python.timeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "How long one Python derivation may run before its session is stopped. A derivation that hangs holds the interpreter, so stopping the process is the only way to end it; the next run starts a fresh one."
        },
        "aot.python.idleTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "description": "How long an idle Python session is kept. Its live results (a DataFrame one derivation made for the next) go with it; the next run recomputes what it needs."
        },
        "aot.python.maxResultBytes": {
          "type": "number",
          "default": 8000000,
          "description": "The largest result one Python derivation may send back. A bigger one stops the session with a message rather than filling memory; return less, or write it to a file."
        },
        "aot.python.maxInlineText": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "description": "Text a Python derivation returns longer than this (or holding a line break) is written to 'aot.files/<name>.md', and the value becomes that file's path."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "aotAttribute",
        "description": "A table cell's attribute"
