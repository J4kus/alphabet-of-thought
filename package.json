{
  "name": "alphabet-of-thought",
  "displayName": "alphabet of thought",
  "description": "distill your creativity into code",
  "keywords": [
    "aot",
    "alphabet of thought",
    "programming language",
    "syntax highlighting",
    "code editor",
    "ideas"
  ],
  "license": "MIT",
  "version": "1.11.9",
  "publisher": "Jakus",
  "icon": "alpha.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node out/test-linter.js && node out/test-table.js && node out/test-extension.js && node out/test-armstrong.js && node out/test-fca.js && node out/test-godel.js && node out/test-derive.js && node out/test-repo.js && node out/test-urls.js && node out/test-hold.js && node out/test-synonyms.js && node out/test-park.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "aot",
        "aliases": [
          "alphabet of thought",
          "aot"
        ],
        "extensions": [
          ".aot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aot",
        "scopeName": "source.aot",
        "path": "./syntaxes/aot.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "alphabet of thought",
      "properties": {
        "aot.tableCsvSync": {
          "type": "boolean",
          "default": true,
          "description": "Mirror every table to a CSV named after its parent Concept in a single 'aot.files' folder at the workspace root (shared by every .aot in the repo), and fold edits made to those CSVs back into the matching table. A CSV whose Concept no table anywhere still has is archived with a '_' prefix, never deleted; legacy 'tables.<file>' / '<file>.tables' folders are folded in automatically."
        },
        "aot.spellingHints": {
          "type": "boolean",
          "default": true,
          "description": "Hint words longer than four characters that neither British nor American English knows, with suggestions. Hints show on their span and on hover, never in the Problems panel."
        },
        "aot.exampleHints": {
          "type": "boolean",
          "default": true,
          "description": "Hint a value that names no Example of the Concept typing its attribute \u2014 'person: James' where Person's Examples are Socrates alone. Only Concepts that list Examples are held to, and only values of the same kind as those Examples (a truth value or a measurement never counts). Hints show on their span and on hover, never in the Problems panel; the Quick Fix lists the Example."
        },
        "aot.autoReconcile": {
          "type": "boolean",
          "default": true,
          "description": "Keep a Concept that appears in more than one .aot in step, on save. An attribute a peer declares and this file does not have in force is written in, and the '...' line saying how many Examples live elsewhere is kept true. Additive only: nothing you wrote is deleted, and no other file is touched. The disagreements no tool may settle \u2014 one attribute carrying two values, one Concept filed under two kinds \u2014 stay put as errors. Off, the drift is reported as a warning instead."
        },
        "aot.synonymWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Warn when two Concepts look like two names for one idea \u2014 'Client' beside 'Customer' (two words for one idea), 'Governance' beside 'Government' (one word with two endings). Repo-wide: a peer in another .aot counts, and the warning carries a link to it. Advisory, never counted in V; the lightbulb either renames one to the other or records the pair in aot.distinctConcepts and stops asking."
        },
        "aot.distinctConcepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Pairs of Concept names you have declared genuinely different, written 'client|customer'. The synonym warning skips them, in either order and in any file. The Quick Fix on the warning adds the pair here."
        },
        "aot.acceptedWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Your own vocabulary, case-insensitive: the spelling hints accept these words, and a Concept whose last word is one of them is not flagged as plural. The Quick Fix on either finding adds the word here."
        },
        "aot.dependencyFindings": {
          "type": "boolean",
          "default": false,
          "description": "Surface inferred functional-dependency warnings (derivable / equivalent attributes) as editor squiggles. Off by default \u2014 correlated attributes are allowed; 'node verify.js --fd' always shows the full set."
        },
        "aot.chainHints": {
          "type": "boolean",
          "default": true,
          "description": "Show an abbreviated dependency chain in faint inline text (an inlay hint) at the end of lines whose crosslink declares a dependency \u2014 the full chains stay on hover."
        },
        "aot.urlMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Hovering a URL in a value fetches light metadata (status, content type, last modified) with a HEAD request, cached for a few minutes. Ctrl+click always opens the URL, metadata or not."
        },
        "aot.parkedValueMarks": {
          "type": "boolean",
          "default": true,
          "description": "Tint every value whose derivation is parked in 'aot.files/<file>.formulas', so a computed number is never mistaken for a typed one. Hover names the formula and offers to put the derivations back. The mark is a background only \u2014 no text is added, so a marked cell keeps the width its column aligned it to."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "aotAttribute",
        "description": "A table cell's attribute"
      },
      {
        "id": "aotExample",
        "description": "A table cell's Example name"
      },
      {
        "id": "aotValue",
        "description": "A table cell's Attribute Value"
      },
      {
        "id": "aotFormula",
        "description": "A formula or constraint"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "aot",
        "scopes": {
          "aotAttribute": [
            "variable.other.property.aot"
          ],
          "aotExample": [
            "constant.language.individual.aot"
          ],
          "aotValue": [
            "string.unquoted.value.aot"
          ],
          "aotFormula": [
            "keyword.control.formula.aot"
          ]
        }
      }
    ],
