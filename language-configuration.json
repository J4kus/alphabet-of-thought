{
    // Ctrl+/ takes a line out of the model and puts it back: a `...` line is a
    // Map, and says nothing to the model. The language has no block comment.
    "comments": {
        "lineComment": "..."
    },
    // symbols used as brackets
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    // symbols that are auto closed when typing. An apostrophe is a letter of
    // a name here ("Aristotle's Ethics", "doesn't"), not a quote — the
    // language's verbatim marker is the backtick — so typing one never
    // conjures a partner. It stays in surroundingPairs: quoting a selection
    // is deliberate, typing a possessive is not.
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ]
}