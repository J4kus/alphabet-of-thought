{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "alphabet of thought",
    "fileTypes": ["json"],
	"patterns": [
		{
            "comment": "Concept: a type / class, the structural backbone",
            "name": "entity.name.type.concept.aot",
            "match": "[A-Z][^(:\"'`]*(?=[(:\"'`]|$)"
        },
        {
            "comment": "attribute: a property / slot",
            "name": "variable.other.property.aot",
            "match": "\\b[a-z]\\w*\\b"
        },
        {
            "comment": "value: the data after a colon",
            "name": "string.unquoted.value.aot",
            "match": ":.*$"
        },
        {
            "comment": "example: a named instance / individual",
            "name": "constant.language.individual.aot",
            "match": "-.*$"
        },
        {
            "comment": "alias: a parenthetical secondary name (recedes)",
            "name": "entity.other.attribute-name.alias.aot",
            "match": "\\([^)]*\\)"
        },
        {
            "comment": "literal: verbatim / raw text in backticks",
            "name": "markup.inline.raw.literal.aot",
            "match": "`[^`]*`"
        },
        {
            "comment": "map / note: explanatory prose (recedes)",
            "name": "comment.line.map.aot",
            "match": "\\.{3}.*$"
        },
        {
            "comment": "deprecated: invalid / struck-through",
            "name": "invalid.deprecated.aot",
            "match": "~.*"
        },
        {
            "comment": "table row: the '|' form of an Example — khaki (support.function), distinct from the blue of '- ' Examples so tabular data reads as its own thing",
            "name": "support.function.table.aot",
            "match": "\\|.*$"
        }

	],
	"scopeName": "source.aot"
}